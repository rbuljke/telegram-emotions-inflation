# --- Секреты. Держать в самом верху и никогда не коммитить ---
.env
.env.*
*.key
secrets.json
credentials.json
gigachat_token*
telegram_session*
*.session
*.session-journal

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Виртуальные окружения ---
venv/
env/
ENV/
.venv/
.conda/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py
